# Configure no ambiente (Secrets no Replit). O Node também aceita --env-file=.env.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/cosmos.sqlite
# Em HTTPS, ative cookies seguros:
COOKIE_SECURE=false
# Ative somente com proxies controlados, que sobrescrevam ou acrescentem o IP
# da conexão recebida em X-Forwarded-For. Cadastre os IPs exatos desses proxies.
# Não ative no Codespace sem conhecer a configuração do proxy de entrada.
TRUST_PROXY=false
TRUSTED_PROXY_IPS=
