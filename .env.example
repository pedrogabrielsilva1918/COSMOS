# Configure no ambiente (Secrets no Replit). O Node também aceita --env-file=.env.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/cosmos.sqlite
# Em HTTPS, ative cookies seguros:
COOKIE_SECURE=false
# Atrás de um proxy confiável (Replit, Nginx), ative para que o limite de tentativas
# use o IP real de cada cliente em vez do IP do proxy. Deixe false em acesso direto.
TRUST_PROXY=false
